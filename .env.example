# ══════════════════════════════════════════════════════════════════════════════
# Innotel Platform Stack — Central Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in values.  Every group reads this file; values that
# only apply to a single group are noted in comments.
# ══════════════════════════════════════════════════════════════════════════════

# ── Global ────────────────────────────────────────────────────────────────────
DOMAIN=innotel.us
BASE_IMAGE_TAG=latest

# ── Component downloads (`./stack.sh download …`) ────────────────────────────
# Components are cloned as siblings of this repo (the location the group
# compose files build from). Point at another parent directory here or per run
# with `--dir <path>`; GITHUB_BASE redirects to a mirror.
STACK_COMPONENT_BASE=
# GITHUB_BASE=https://github.com

# ── Mesh network (WireGuard) ─────────────────────────────────────────────────
# Each server gets a unique /32 inside the 10.10.0.0/16 overlay.
# Generate keys:  docker run --rm ghcr.io/innotelinc/wg genkey | tee privatekey | wg pubkey > publickey
MESH_NETWORK=10.10.0.0/16
MESH_PORT=51820

# Server IPs on the mesh (one per server / group)
SERVER_1_PRIMARY_IP=10.10.1.1     # Cerulean + AthenIQ + Magnate
SERVER_2_VOICE_IP=10.10.2.1       # Capstone + Zeus
SERVER_3_MEDIA_IP=10.10.3.1       # Monarch
SERVER_4_SOCIAL_IP=10.10.4.1      # Rizzaura + Onyx
SERVER_5_DEV_IP=10.10.5.1         # Atlas + Oasis

# Public IPs of each server (for WireGuard endpoint)
SERVER_1_PUBLIC_IP=73.68.203.71
SERVER_2_PUBLIC_IP=
SERVER_3_PUBLIC_IP=
SERVER_4_PUBLIC_IP=
SERVER_5_PUBLIC_IP=

# WireGuard keys (generate per-server, paste here)
SERVER_1_WG_PRIVATE_KEY=
SERVER_1_WG_PUBLIC_KEY=
SERVER_2_WG_PRIVATE_KEY=
SERVER_2_WG_PUBLIC_KEY=
SERVER_3_WG_PRIVATE_KEY=
SERVER_3_WG_PUBLIC_KEY=
SERVER_4_WG_PRIVATE_KEY=
SERVER_4_WG_PUBLIC_KEY=
SERVER_5_WG_PRIVATE_KEY=
SERVER_5_WG_PUBLIC_KEY=

# Pre-shared key for extra security (optional, one per peer pair)
MESH_PSK=

# ── Service Registry ─────────────────────────────────────────────────────────
# Consul runs on Group 1. All groups register here.
REGISTRY_ADDR=10.10.1.1:8500
REGISTRY_ENCRYPT_KEY=         # gossip encrypt key (consul keygen)

# ── Subscribe portal (web/subscribe) — edge NPM wiring ──────────────────────
# One nginx serves every service's subscription landing page by Host header:
#   subscribe.<service>.innotel.us -> that service's page
#   subscribe.innotel.us (apex)    -> the directory of every service
# scripts/subscribe-hosts.py asserts the matching proxy hosts on the edge NPM
# (run it with --check to see drift). The NPM_* credentials are the edge NPM's
# admin login — the same one the per-product npm-proxy-hosts.py scripts use.
NPM_API_URL=http://192.168.1.46:81
NPM_ADMIN_EMAIL=
NPM_ADMIN_PASSWORD=
NPM_API_TOKEN=                # optional: a persistent token instead of a login
SUBSCRIBE_PORTAL_HOST=192.168.1.46
SUBSCRIBE_PORTAL_PORT=3040

# ── Cerulean (Group 1) ──────────────────────────────────────────────────────
CERULEAN_PORT=3003
CERULEAN_ADMIN_PASSWORD=DD@l1lama
CERULEAN_TOKEN_TTL_HOURS=12
AUTHENTIK_IMAGE_TAG=2024.12.2
AUTHENTIK_BOOTSTRAP_PASSWORD=hTT2G5ACG3eK8IJ21WoVDOJ8
AUTHENTIK_BOOTSTRAP_TOKEN=9567dd4ffdcdb2367f81c10adbbdbd4b8b5ed779b0048ba6
AUTHENTIK_BOOTSTRAP_EMAIL=admin@cerulean.innotel.us

# ── AthenIQ / Tutor (Group 1) ───────────────────────────────────────────────
TUTOR_USER=tutor
OPENEDX_LMS_HOST=learn.innotel.us
OPENEDX_CMS_HOST=studio.innotel.us
OPENEDX_MFE_HOST=mfe.learn.innotel.us
# LMS/CMS publish their origin ports directly — public hostnames (learn./studio.)
# terminate at the shared NPM edge, not a local Caddy.
OPENEDX_LMS_PORT=18000
OPENEDX_CMS_PORT=18001
OIDC_CLIENT_ID=atheniq-lms
OIDC_CLIENT_SECRET=
OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/atheniq-lms/

# ── Magnate (Group 1) ───────────────────────────────────────────────────────
MAGNATE_PORT=3010
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Signara (Group 1 — DocumentOps) ──────────────────────────────────────────
SIGNARA_API_PORT=8000
SIGNARA_WEB_PORT=3000
SIGNARA_PG_PASSWORD=signarapass
SIGNARA_REDIS_PASSWORD=signararedis
SIGNARA_API_IMAGE=ghcr.io/innotelinc/signara-api:latest
SIGNARA_WEB_IMAGE=ghcr.io/innotelinc/signara-web:latest
S3_ACCESS_KEY=signara
S3_SECRET_KEY=
MEILISEARCH_API_KEY=
API_URL=https://api.signara.innotel.us
WEB_URL=https://app.signara.innotel.us

# ── Capstone (Group 2) ──────────────────────────────────────────────────────
CAPSTONE_FREERPBX_PORT=8083
CAPSTONE_API_PORT=3000
CAPSTONE_REDIS_PASSWORD=redissecret
CAPSTONE_POSTGRES_PASSWORD=capstonepass

# ── Zeus (Group 2) ──────────────────────────────────────────────────────────
ZEUS_PORT=3001
ZEUS_COTURN_PORT=3478

# ── Monarch (Group 3) ───────────────────────────────────────────────────────
MONARCH_JELLYFIN_PORT=8096
MONARCH_PROWLARR_PORT=9696
MONARCH_SONARR_PORT=8989
MONARCH_RADARR_PORT=7878

# ── PLUTUS (Group 3, VideoOps) ──────────────────────────────────────────────
# Self-hosted AI shopping channel (innotelinc/plutus): Convex backend with
# ffmpeg, Convex dashboard, and the Next.js static export served by nginx.
# Build the export once in the checkout (`bun run build` → out/); the Convex
# admin key comes from `docker compose exec plutus-backend ./generate_admin_key.sh`.
# Per-pipeline settings (OMNIROUTE_BASE_URL, S3, INSTANCE_SECRET, Authentik SSO)
# are set in the checkout with `npx convex env set …`, per PLUTUS's .env.example.
PLUTUS_CONVEX_PORT=3210
PLUTUS_SITE_PROXY_PORT=3211
PLUTUS_DASHBOARD_PORT=6791
PLUTUS_WEB_PORT=3000
PLUTUS_ADMIN_SECRET=                     # protects clearMockData (change in production)
PLUTUS_RUST_LOG=info
# Optional overrides for the origins Convex advertises to browsers (default to
# 127.0.0.1 with the ports above; set the LAN address for remote devices):
# PLUTUS_CONVEX_CLOUD_ORIGIN=http://192.168.1.46:3210
# PLUTUS_CONVEX_SITE_ORIGIN=http://192.168.1.46:3211

# ── Rizzaura (Group 4) ─────────────────────────────────────────────────────
RIZZ_API_PORT=8000
RIZZ_APP_PORT=3010
RIZZ_RANKINGS_PORT=3011
RIZZ_COMMUNITY_PORT=3012
RIZZ_ADMIN_PORT=3013

# ── ONYX (Group 4) ──────────────────────────────────────────────────────────
ONYX_API_PORT=8080
ONYX_OBJECTSTORE_PORT=9001

# ── Oasis (Group 5) ─────────────────────────────────────────────────────────
OASIS_MAIL_PORT=25
OASIS_SMTP_PORT=587
OASIS_IMAP_PORT=993
OASIS_WEB_PORT=8443

# ── OmniRoute (single instance on Zeus / Group 2) ───────────────────────────
OMNIROUTE_PORT=20128
OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest

# ── Distro (Group 5, BuilderOps) ────────────────────────────────────────────
# The control plane — Distro's tenancy service (accounts, per-user gateway
# keys, quotas/usage, admin console; innotelinc/distro). The bolt.diy web
# front door is retired (convergence §5.2): one web UI (Studio, Group 4)
# serves the ecosystem. It consumes the shared Group-2 OmniRoute over the
# mesh — no bundled gateway, so no gateway ports are published here.
# MESH_GATEWAY_HOST is the Group-2 server that runs it, MESH_CONSUL_ADDR the
# registry Distro discovers it through.
MESH_GATEWAY_HOST=10.10.2.1
MESH_CONSUL_ADDR=10.10.1.1:8500
DISTRO_CONTROL_PORT=20140
DISTRO_INITIAL_PASSWORD=                  # shared gateway dashboard admin password
DISTRO_ADMIN_EMAILS=                      # comma-separated; first signup is admin
OPENAI_LIKE_API_KEY=                      # service key: mints/revokes per-user gateway keys
DISTRO_ENFORCE_QUOTA=true
VITE_DEFAULT_MODEL=gemini/gemini-2.5-flash
VITE_PUBLIC_ORIGIN=https://slots.innotel.us
# Service-to-service token for Distro's control plane (`/api/internal/identity`,
# `/api/internal/audit`), which Olympus's Studio presents to turn a signed-in
# Authentik subject into a control-plane account + that user's gateway key.
# Generated by Distro's ./scripts/bootstrap.sh; unset = those routes answer 503.
CONTROL_INTERNAL_TOKEN=

# ── Olympus (Group 5, FactoryOps) ───────────────────────────────────────────
# Sibling checkout (innotelinc/olympus). The factory container publishes no
# port; Studio (vibe-coding UI) publishes 3001. Its AI plane points at the
# bundled Group-5 gateway by default — switch OLYMPUS_OMNIROUTE_BASE_URL to the
# canonical Group-2 OmniRoute over the mesh (http://10.10.2.1:20128/v1) to use
# the single shared gateway instead. The host-side build runner lives in the
# Olympus checkout (systemd unit) and shares build-requests/ + .factory/build-queue.
OLYMPUS_STUDIO_PORT=3001
OLYMPUS_OMNIROUTE_BASE_URL=http://distro-gateway:20129/v1
OLYMPUS_OMNIROUTE_API_KEY=              # falls back to OPENAI_LIKE_API_KEY when empty
OLYMPUS_OMNIROUTE_MODEL=auto/coding    # must be a model that calls tools
OLYMPUS_OMNIROUTE_MODEL_FALLBACK=auto
OLYMPUS_TELEGRAM_BOT_TOKEN=
OLYMPUS_STUDIO_ACCESS_TOKEN=            # optional shared access token (SSO is preferred)
OLYMPUS_OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/olympus/
OLYMPUS_OIDC_CLIENT_ID=olympus-studio
OLYMPUS_OIDC_CLIENT_SECRET=
OLYMPUS_OIDC_REDIRECT_URI=https://studio.olympus.innotel.us/api/auth/callback
OLYMPUS_OIDC_ALLOWED_GROUPS=            # empty = any authenticated user
OLYMPUS_STUDIO_SESSION_SECRET=
