[Unit]
Description=Daily check that regcache's Docker Hub token still works

[Timer]
OnBootSec=30min
# Morning, before the day's images are pulled, and not on the hour.
OnCalendar=*-*-* 06:10:00
RandomizedDelaySec=5min
Persistent=true
Unit=regcache-credential.service

[Install]
WantedBy=timers.target
