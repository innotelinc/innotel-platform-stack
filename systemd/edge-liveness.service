[Unit]
Description=Watch the Cerulean edge from off the edge
Documentation=https://github.com/innotelinc/innotel-platform-stack/blob/main/docs/container-placement.md

# Runs on a host that is NOT the edge. Every other estate check — and the Prometheus that
# evaluates their rules — lives on the edge (`proxy`), so none of them can report the edge
# being gone. This one can, because it is somewhere else: `i4` since 2026-10-09.
#
# The unit and the edge must never share a host — that is the whole point of it. It was
# installed on `i1` *because* the edge was not there, and the 2026-10-09 placement change
# moved the edge back onto `i1`, briefly co-locating them; the same change gave `i4` a wired
# uplink and left it carrying `atheniq`, `mail`, `vault` and `vpn`, so the watcher moved
# there the same day. Whoever changes placement next checks the pair: the host this unit is
# installed on must not carry `proxy`. See docs/container-placement.md §Changes applied
# 2026-10-09.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/innotel/edge-liveness

# EDGE_LIVENESS_MAIL_TO is the outward channel: an address gets the failure by mail
# through EDGE_LIVENESS_SMTP_HOST, the estate's own mail server. It is deliberately not
# the estate's Alertmanager — that one runs on the edge's side and its delivery config is
# empty (docs/container-placement.md §Open items) — and it does not depend on a credential
# nobody has verified. Set it in /etc/innotel/edge-liveness.env; empty means no mail.
#
# EDGE_LIVENESS_NOTIFY is any other command run with the failure text on stdin (a webhook,
# an Alertmanager's /api/v2/alerts), also empty by default.
#
# LIVENESS_TEXTFILE_DIR is where this host's node-exporter (if one is pointed at that
# directory) can collect the result for a Prometheus off the edge; on `i4` today no
# collector reads it, so it is written for whoever wires one up first.
EnvironmentFile=-/etc/innotel/edge-liveness.env
Environment=LIVENESS_TEXTFILE_DIR=/var/lib/node_exporter/textfile
Environment=EDGE_LIVENESS_MAIL_TO=
Environment=EDGE_LIVENESS_SMTP_HOST=192.168.1.15
Environment=EDGE_LIVENESS_NOTIFY=

# The exit status is left to fail on purpose: an unreachable edge makes this unit failed, so
# `systemctl --failed` on this host is a second, dependency-free place the problem shows up.
ExecStart=/usr/bin/python3 /opt/innotel/edge-liveness/check-edge-liveness.py \
  --prom ${LIVENESS_TEXTFILE_DIR}/edge-liveness.prom \
  --mail-to ${EDGE_LIVENESS_MAIL_TO} \
  --smtp-host ${EDGE_LIVENESS_SMTP_HOST} \
  --notify ${EDGE_LIVENESS_NOTIFY}
