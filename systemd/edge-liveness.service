[Unit]
Description=Watch the Cerulean edge from off the edge
Documentation=https://github.com/innotelinc/innotel-platform-stack/blob/main/docs/container-placement.md

# Runs on a host that is NOT the edge. Every other estate check — and the Prometheus that
# evaluates their rules — lives on the edge (`i4` `proxy`), so none of them can report the
# edge being gone. This one can, because it is somewhere else.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/innotel/edge-liveness

# EDGE_LIVENESS_NOTIFY is the outward channel: any command run with the failure text on
# stdin (a `sendmail` line, a `curl` to a webhook or to Alertmanager's /api/v2/alerts).
# It is empty here, so the signal is the failed unit and the journal — please point it at
# a real receiver. LIVENESS_TEXTFILE_DIR is where this host's node-exporter (if one is
# pointed at that directory) can collect the result for a Prometheus off the edge; on `i1`
# today no collector reads it, so it is written for whoever wires one up first.
# Put either in /etc/innotel/edge-liveness.env.
EnvironmentFile=-/etc/innotel/edge-liveness.env
Environment=LIVENESS_TEXTFILE_DIR=/var/lib/node_exporter/textfile
Environment=EDGE_LIVENESS_NOTIFY=

# The exit status is left to fail on purpose: an unreachable edge makes this unit failed, so
# `systemctl --failed` on this host is a second, dependency-free place the problem shows up.
ExecStart=/usr/bin/python3 /opt/innotel/edge-liveness/check-edge-liveness.py --prom ${LIVENESS_TEXTFILE_DIR}/edge-liveness.prom --notify ${EDGE_LIVENESS_NOTIFY}
