[Unit]
Description=Disable WiFi power save on the i4 host's uplink (wlp1s0)

# i4's only uplink is WiFi and its containers are routed over it (see
# docs/container-placement.md §The i4 host). With power save on, the radio holds frames
# until the next DTIM beacon — measured 2026-10-02 at ~312 ms spacing — so an *idle*
# container's replies arrive 100-900 ms late while a busy one (the edge) looks fine,
# because its own traffic keeps the radio awake. That is a latency trap with no error
# and no metric: it reads as "the WiFi hop is too slow for the edge", when the fix is
# this one setting. Measured on 2026-10-02, from a wired LAN client to i4's containers:
#
#   power save on : .22 avg 155 ms / max 895 ms, .73 avg 165 ms / max 912 ms
#   power save off: .22 avg  12 ms / max  22 ms, .73 avg  11 ms / max  24 ms
#
# So the edge does not need a wired NIC for latency; it needs the radio not to sleep.
After=network-online.target wpa_supplicant.service
Wants=network-online.target
# Re-apply when the supplicant restarts — a reconnect can reset the driver setting.
PartOf=wpa_supplicant.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/iw dev wlp1s0 set power_save off

[Install]
WantedBy=multi-user.target
