[Unit]
Description=Run the container address invariant check every half hour

[Timer]
# Half-hourly: often enough that a renumber is caught before anyone dials the
# service, cheap enough that the ssh round-trip to three hosts does not matter.
OnBootSec=5m
OnCalendar=*:0/30
Persistent=true
RandomizedDelaySec=1m

[Install]
WantedBy=timers.target
