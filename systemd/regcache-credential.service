[Unit]
Description=Check that regcache's Docker Hub credential still authenticates
Documentation=file:///usr/local/sbin/regcache-credential-check.sh
After=network-online.target incus.service
Wants=network-online.target

# An expired token does not take the cache down - cached images keep serving -
# so nothing else notices. This is the unit that notices, and OnFailure puts the
# finding somewhere a person will see it instead of in the journal.
OnFailure=estate-notify@%n

[Service]
Type=oneshot
# Exit 1 = the token is dead or uncached pulls are already failing on the
# anonymous limit; exit 2 = the check itself could not run, which is never a pass.
ExecStart=/usr/local/sbin/regcache-credential-check.sh
