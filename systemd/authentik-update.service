[Unit]
Description=Move Cerulean's Authentik server and worker to the newest release
Documentation=https://github.com/innotelinc/cerulean
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# A failed run alerts for itself (the script mails ALERT_EMAIL_TO / posts
# ALERT_WEBHOOK_URL); this covers the failures it cannot describe — killed,
# docker gone, start limit hit.
OnFailure=authentik-update-failed.service

[Service]
Type=oneshot
User=root
Nice=10
# The checkout layout, a GITHUB_TOKEN for the releases API, the alert channel
# (ALERT_EMAIL_TO / ALERT_WEBHOOK_URL), the outpost host, or a different health
# URL go here; every value is optional and the unit runs without the file.
EnvironmentFile=-/etc/innotel/authentik-update.env
Environment=ESTATE_ROOT=/usr/src/projects/complete
ExecStart=/opt/innotel/authentik-update/authentik-update.sh
