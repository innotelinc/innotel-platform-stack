# christ staging — telephony disabled
#
# Copy to .env.staging and fill in. This file is the one the deploy runbook
# passes with --env-file, and it is the file that must NEVER contain a trunk
# credential while `telno` is live on another host.
#
# The upstream compose fails closed on three variables (`${VAR:?}`), which is
# deliberate: it will not start half-configured. FAX_SECRET is the fourth, and
# it is only required if the fax profile is ever enabled.

# ---- identity -------------------------------------------------------------
PUBLIC_URL=http://localhost:8080
PUBLIC_IP=127.0.0.1
CHRIST_TAG=local
CANTUS_DOMAIN=staging.local
CANTUS_ID=switch@staging.local

# ---- required, fail-closed ------------------------------------------------
# CANTUS_SECRET is shared by every Cantus node in one deployment. For staging,
# generate a fresh one: a distinct value keeps staging's voice plane isolated.
#   openssl rand -hex 32
CANTUS_SECRET=CHANGE_ME_openssl_rand_hex_32

# The control token the front door authenticates with. The recovered instance's
# own value was not in any snapshot, so staging issues its own.
#   openssl rand -hex 32
CANTUS_CONTROL_TOKEN=CHANGE_ME_openssl_rand_hex_32

# agents profile only
#   openssl rand -hex 32
DOGRAH_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---- ports (staging must not fight the live edge) --------------------------
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443
SWITCH_PORT=8188
CHRIST_PORT=8001
ESTATE_PORT=8000
DOGRAH_PORT=8100
DOGRAH_UI_PORT=3010
TTS_PORT=8881
CAPSTONE_PORT=8096
CAPSTONE_STUDIO_PORT=8097
CAPSTONE_API_PORT=8098

# ---- agents (dograh) ------------------------------------------------------
DOGRAH_DB_PASSWORD=CHANGE_ME
DOGRAH_REDIS_PASSWORD=CHANGE_ME
DOGRAH_API_IMAGE=dograh-api:local
DOGRAH_UI_IMAGE=dograh-ui:local
DOGRAH_URL=http://localhost:8100
DOGRAH_PUBLIC_URL=http://localhost:8100
DOGRAH_UI_URL=http://localhost:3010
DOGRAH_SIGNUP=false
MINIO_ROOT_USER=staging
MINIO_ROOT_PASSWORD=CHANGE_ME

# ---- console --------------------------------------------------------------
ADMIN_EMAIL=admin@staging.local
ADMIN_PASSWORD=CHANGE_ME

# ---- capstone / n8n / grist ----------------------------------------------
CAPSTONE_URL=http://localhost:8096
CAPSTONE_PUBLIC_URL=http://localhost:8080
N8N_HOST=localhost
N8N_PORT_PUBLISHED=5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_TIMEZONE=America/New_York
GRIST_ADMIN_EMAIL=admin@staging.local
GRIST_PORT=8484

# ---- mail notifications (optional) ---------------------------------------
NOTIFY_FROM=staging@staging.local

# ===========================================================================
# DELIBERATELY ABSENT — do not add these on this stack.
#
#   VOIPMS_API_USERNAME   VOIPMS_API_PASSWORD
#   VOIPMS_SIP_USERNAME   VOIPMS_SIP_PASSWORD
#   VOIPMS_SIP_HOST       VOIPMS_SIP_DOMAIN
#   VOIPMS_SIP_FROM_USER  VOIPMS_SIP_PORT
#   SIP_ATA_USERS         SIP_BIND_PORT        SIP_SRTP
#   FAX_SECRET            FAX_SIP_*            FAX_IAX_*
#   GATEWAY_*             TELNO_*
#
# Any of these, together with the pstn/platform/fax profiles, would put a second
# registration on the trunk that the live telno on i4 is holding. The gateway
# and fax services are re-homed to the "never-pstn" profile in
# compose.staging.yml so they cannot start even by accident.
# ===========================================================================
