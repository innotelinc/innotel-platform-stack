# Env for docker-compose.host.yml (standalone per-host metrics).
# Copy to `.env.host` on the host — it is gitignored, and GRAFANA_PASSWORD must
# not be committed. Generate it with: openssl rand -hex 16

GRAFANA_PASSWORD=change-me

# Host ports (loopback only). Check they are free first: `.56` runs sabnzbd on
# 127.0.0.1:9090, so that host needs PROMETHEUS_PORT=9095.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3301

# Retention is capped by time AND size so neither is unbounded.
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=1GB

# Directory this host publishes Prometheus textfiles from — mounted read-only
# into node-exporter and read by its textfile collector, so a scheduled job's
# `status.prom` becomes scrapeable metrics with nothing else to configure.
# Set it only where a job actually writes one; left unset it is an empty
# directory, and the rules that key on those series stay quiet.
#   .71 (Cerulean): /root/cerulean-backup/authentik
TEXTFILE_DIR=/var/lib/node_exporter/textfile

# Image pins (override only to move deliberately).
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
PROMETHEUS_IMAGE=prom/prometheus:v3.13.3
GRAFANA_IMAGE=grafana/grafana:13.2.2
