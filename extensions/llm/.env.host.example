# ══════════════════════════════════════════════════════════════════════════════
# Extension: llm — env for the STANDALONE host variant (`docker-compose.host.yml`)
# ══════════════════════════════════════════════════════════════════════════════
# Copy to `.env.host` on the gateway's host and fill the secrets in; it is
# gitignored and is what `--env-file .env.host` loads.
#
#   cp .env.host.example .env.host      # then fill it
#
# The GATEWAY_* names are the repo-idiomatic spelling (the same keys
# `5-dev/olympus/.env` and `2-voice/capstone/.env` carry); the container's
# OAUTH2_PROXY_* / INITIAL_PASSWORD aliases are translated in the compose file, so
# only this vocabulary exists here.

# ── the gateway itself ───────────────────────────────────────────────────────
OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest
# Mints/verifies the gateway's own API keys, and encrypts the provider
# connections in the volume. Changing either INVALIDATES what is stored.
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
# The container reads `INITIAL_PASSWORD` and only that name (see the compose
# file). This is the dashboard password, and it is the credential a restore from
# Vault cannot bring back — keep it with the other secrets.
OMNIROUTE_INITIAL_PASSWORD=
OMNIROUTE_WS_BRIDGE_SECRET=

# ── the door (oauth2-proxy) ──────────────────────────────────────────────────
# THE LAN ADDRESS OF THE GATEWAY'S HOST, not 0.0.0.0: the gateway already holds
# 127.0.0.1:20128 and 172.17.0.1:20128, so a wildcard bind fails EADDRINUSE.
GATEWAY_SSO_BIND=192.168.1.71
GATEWAY_SSO_PORT=20128
GATEWAY_SSO_UPSTREAM=http://127.0.0.1:20128
GATEWAY_PUBLIC_HOST=gateway.studio.innotel.us
GATEWAY_SLUG=omniroute
GATEWAY_OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/omniroute/
GATEWAY_OIDC_CLIENT_ID=omniroute
GATEWAY_OIDC_CLIENT_SECRET=
GATEWAY_SSO_COOKIE_SECRET=
GATEWAY_SSO_ALLOWED_GROUP=cerulean-platform
GATEWAY_SSO_WHITELIST_DOMAIN=.innotel.us
GATEWAY_OIDC_ALLOWED_SUBJECTS=
# Server-side sessions (see the compose file for why the cookie store cannot be
# used). Refused at start-up when empty.
GATEWAY_SSO_REDIS_PASSWORD=
GATEWAY_SSO_REDIS_PORT=16379

# ── the edge forwarding host (consumed by the edge tooling, not this stack) ───
# The address the NPM proxy hosts for gateway.* forward TO — this host.
GATEWAY_SSO_EDGE_FORWARD_HOST=192.168.1.71
